# Optional. Turns on the "Connect wallet" button (real WalletConnect) on /pay.
# 1. Create a free project at https://dashboard.reown.com
# 2. Add your site's address to the project's allowed domains (http://localhost:3000 for local work)
# 3. Copy this file to .env.local and paste the project ID below, then restart the dev server.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Optional. Where the SQLite database file lives. Default: ./data/paylane.db
# (Docker sets this to /data/paylane.db and keeps it in a volume.)
DATABASE_PATH=./data/xxx.db

# Optional. A Turso database (libSQL) for hosting on Vercel. When both are set,
# they win over DATABASE_PATH. Get them with:
#   turso db create paylane && turso db show paylane --url && turso db tokens create paylane
TURSO_DATABASE_URL=libsql://xxx.turso.io
TURSO_AUTH_TOKEN=
